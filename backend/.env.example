SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set DB_ENGINE=postgresql to switch off the default SQLite database
DB_ENGINE=sqlite
DB_NAME=asa_academy
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@asaacademy.com
FRONTEND_URL=http://localhost:5173

# Switch EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend and set
# these to send real emails (registration OTP, login 2FA, instructor
# invitations, etc). Never commit real values — set them in your local .env
# or your deployment platform's secret manager only.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_USE_TLS=True

# Authentication.md OTP / instructor-invitation lifecycle — safe to leave at
# these defaults.
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
INSTRUCTOR_INVITATION_EXPIRATION_HOURS=24

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Sign-In (see google-login.md) — same client ID the frontend uses
# (VITE_GOOGLE_CLIENT_ID). Leave blank to keep "Continue with Google" hidden.
GOOGLE_CLIENT_ID=
