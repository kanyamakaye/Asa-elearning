# Variables for `docker compose up` — copy this file to `.env` (same folder
# as docker-compose.yml) and fill in real values before deploying anywhere
# that isn't your own machine. Every var has a dev-friendly default baked
# into docker-compose.yml, so this file only needs to override what you
# actually want to change.
#
# This is separate from backend/.env.example, which is for running the
# Django app directly (outside Docker) against a local SQLite database.

SECRET_KEY=change-me-to-a-long-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend

DB_NAME=asa_academy
DB_USER=postgres
DB_PASSWORD=postgres

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@asaacademy.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_USE_TLS=True

# Browser-facing URLs — must match however you actually expose these
# services (the defaults assume the ports published in docker-compose.yml).
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api/v1
